---
import '../styles/global.css';
import { clientes } from '../data/toc';
import { url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Guía complementaria de Laboratorio de Bases de Datos sobre la conexión de agentes de IA a bases de datos SQL.' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      // Aplica las preferencias guardadas antes del primer pintado para evitar
      // que se vea, por un instante, la variante equivocada.
      (function () {
        var d = document.documentElement;
        function get(k) {
          try { return localStorage.getItem(k); } catch (e) { return null; }
        }
        d.dataset.engine = get('guia.engine') || 'postgresql';
        d.dataset.client = get('guia.client') || 'claude-code';
        var accent = get('guia.accent');
        if (accent) d.dataset.accent = accent;
        var theme = get('guia.theme');
        if (theme) d.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class="topbar">
      <div class="topbar__inner">
        <a class="topbar__title" href={url('/')}>
          Agentes de IA y bases de datos
          <span>Material complementario de Laboratorio de Bases de Datos</span>
        </a>
        <div class="prefs">
          <div class="pref">
            <span id="lbl-motor">Motor</span>
            <div class="seg" role="group" aria-labelledby="lbl-motor">
              <button type="button" data-set-engine="postgresql">PostgreSQL</button>
              <button type="button" data-set-engine="mysql">MySQL</button>
            </div>
          </div>
          <div class="pref">
            <span id="lbl-cliente">Cliente</span>
            <div class="menu">
              <button
                type="button"
                class="client-trigger"
                id="btn-client"
                aria-haspopup="menu"
                aria-expanded="false"
                aria-controls="client-list"
                aria-labelledby="lbl-cliente btn-client-name"
              >
                <span id="btn-client-name">{clientes[0].nombre}</span>
                <svg class="chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
              </button>
              <div class="menu-list client-list" id="client-list" role="menu" aria-label="Cliente" hidden>
                {[
                  { titulo: 'Agentes', grupo: 'agente' },
                  { titulo: 'Asistentes de chat', grupo: 'asistente' },
                ].map((g) => (
                  <div role="group" aria-label={g.titulo}>
                    <p class="menu-group" aria-hidden="true">{g.titulo}</p>
                    {clientes.filter((c) => c.grupo === g.grupo).map((c) => (
                      <button type="button" role="menuitemradio" aria-checked="false" data-set-client={c.id} data-nombre={c.nombre}>
                        <span class="menu-item-text">
                          <span class="menu-item-name">{c.nombre}</span>
                          <span class="menu-item-detail">{c.detalle}</span>
                        </span>
                        <svg class="check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                      </button>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          </div>
          <div class="menu theme-menu">
            <button
              type="button"
              class="theme-trigger"
              id="btn-theme"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="theme-list"
              aria-label="Tema"
              data-pref="sistema"
            >
              <svg data-icon="sistema" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
              <svg data-icon="claro" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
              <svg data-icon="oscuro" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" /></svg>
            </button>
            <div class="menu-list theme-list" id="theme-list" role="menu" aria-label="Tema" hidden>
              <button type="button" role="menuitemradio" aria-checked="false" data-set-theme="sistema">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
                <span>Sistema</span>
                <svg class="check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
              </button>
              <button type="button" role="menuitemradio" aria-checked="false" data-set-theme="claro">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                <span>Claro</span>
                <svg class="check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
              </button>
              <button type="button" role="menuitemradio" aria-checked="false" data-set-theme="oscuro">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" /></svg>
                <span>Oscuro</span>
                <svg class="check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </header>

    <slot />

    <script>
      import { initPrefs } from '../scripts/prefs';
      import { enhanceCode } from '../scripts/code';
      initPrefs();
      enhanceCode();
    </script>
  </body>
</html>
